# Copy this file to .env and replace the values.
# Never commit .env.

SPRING_PROFILES_ACTIVE=default
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@mindcare.local
FRONTEND_URL=http://localhost:5173
INTERNAL_SERVICE_SECRET=replace-with-a-long-random-secret
AUTH_SERVICE_URL=http://localhost:8081
EMOTION_SERVICE_URL=http://localhost:8083
AI_SERVICE_URL=http://localhost:8084
APP_DELETION_WORKER_ENABLED=true
APP_DELETION_POLL_MS=30000
APP_NOTIFICATIONS_WORKER_ENABLED=true
APP_NOTIFICATIONS_POLL_MS=5000
RISK_NOTIFICATIONS_ENABLED=true
RISK_NOTIFICATIONS_POLL_MS=5000
PUSH_NOTIFICATIONS_ENABLED=false
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_RECEIPTS_URL=https://exp.host/--/api/v2/push/getReceipts
EXPO_PUSH_RECEIPT_POLL_MS=300000

GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_CONNECT_TIMEOUT_SECONDS=3
GEMINI_READ_TIMEOUT_SECONDS=15
GEMINI_MAX_ATTEMPTS=2
GEMINI_RETRY_DELAY_MS=250
STRESS_MODEL_ENABLED=false
STRESS_MODEL_PATH=../ml-training/models/stress-classifier-v3.onnx
STRESS_MODEL_VERSION=stress-classifier-v3
WELLNESS_MODEL_ENABLED=false
WELLNESS_SLEEP_MODEL_PATH=../ml-training/models/lifesnaps-sleep-minutes-v1.onnx
WELLNESS_SLEEP_METADATA_PATH=../ml-training/models/lifesnaps-sleep-minutes-v1.metadata.json
WELLNESS_STEPS_MODEL_PATH=../ml-training/models/lifesnaps-steps-v1.onnx
WELLNESS_STEPS_METADATA_PATH=../ml-training/models/lifesnaps-steps-v1.metadata.json
WELLNESS_RESTING_HR_MODEL_PATH=../ml-training/models/lifesnaps-resting-hr-v1.onnx
WELLNESS_RESTING_HR_METADATA_PATH=../ml-training/models/lifesnaps-resting-hr-v1.metadata.json
JWT_SECRET=replace-with-a-base64-encoded-random-secret
SEED_ASSESSMENTS=true
